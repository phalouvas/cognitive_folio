  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bench Web",
      "type": "debugpy",
      "request": "launch",
      "python": "/workspace/development/v16/env/bin/python3",
      "program": "/workspace/development/v16/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "serve",
        "--port",
        "8001",
        "--noreload",
        "--nothreading"
      ],
      "cwd": "/workspace/development/v16/sites",
      "env": {
        "DEV_SERVER": "1"
      }
    },
    {
      "name": "Bench Short Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "/workspace/development/v16/env/bin/python3",
      "program": "/workspace/development/v16/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "worker",
        "--queue",
        "short"
      ],
      "cwd": "/workspace/development/v16/sites",
      "env": {
        "DEV_SERVER": "1"
      }
    },
    {
      "name": "Bench Default Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "/workspace/development/v16/env/bin/python3",
      "program": "/workspace/development/v16/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "worker",
        "--queue",
        "default"
      ],
      "cwd": "/workspace/development/v16/sites",
      "env": {
        "DEV_SERVER": "1"
      }
    },
    {
      "name": "Bench Long Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "/workspace/development/v16/env/bin/python3",
      "program": "/workspace/development/v16/apps/frappe/frappe/utils/bench_helper.py",
      "args": [
        "frappe",
        "worker",
        "--queue",
        "long"
      ],
      "cwd": "/workspace/development/v16/sites",
      "env": {
        "DEV_SERVER": "1"
      }
    },
    {
      "name": "Honcho SocketIO Watch Schedule Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "/home/frappe/.pyenv/shims/python",
      "program": "/home/frappe/.local/bin/honcho",
      "cwd": "${workspaceFolder}/frappe-bench",
      "console": "internalConsole",
      "args": [
        "start",
        "socketio",
        "watch",
        "schedule",
        "worker"
      ],
      "postDebugTask": "Clean Honcho SocketIO Watch Schedule Worker"
    },
    {
      "type": "pwa-msedge",
      "name": "Launch Microsoft Edge",
      "request": "launch",
      "runtimeArgs": [
        "--remote-debugging-port=9222"
      ],
      "url": "c:\\Users\\phalo\\.vscode\\extensions\\ms-edgedevtools.vscode-edge-devtools-2.1.10\\out\\startpage\\index.html",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "pwa-msedge",
      "name": "Launch Microsoft Edge in headless mode",
      "request": "launch",
      "runtimeArgs": [
        "--headless",
        "--remote-debugging-port=9222"
      ],
      "url": "c:\\Users\\phalo\\.vscode\\extensions\\ms-edgedevtools.vscode-edge-devtools-2.1.10\\out\\startpage\\index.html",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "vscode-edge-devtools.debug",
      "name": "Open Edge DevTools",
      "request": "attach",
      "url": "c:\\Users\\phalo\\.vscode\\extensions\\ms-edgedevtools.vscode-edge-devtools-2.1.10\\out\\startpage\\index.html",
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Honcho + Web debug",
      "configurations": [
        "Bench Web",
        "Honcho SocketIO Watch Schedule Worker"
      ],
      "stopAll": true
    },
    {
      "name": "Launch Edge Headless and attach DevTools",
      "configurations": [
        "Launch Microsoft Edge in headless mode",
        "Open Edge DevTools"
      ]
    },
    {
      "name": "Launch Edge and attach DevTools",
      "configurations": [
        "Launch Microsoft Edge",
        "Open Edge DevTools"
      ]
    }
  ]
}
